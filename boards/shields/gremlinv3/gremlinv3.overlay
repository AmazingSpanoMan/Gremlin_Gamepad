#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/analog-stick/modes.h>
#include <dt-bindings/adc/adc.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <physical_layouts.dtsi>

/*
 * Nordic SAADC CH[n].PSELP register values:
 * In nRF52840 SAADC hardware and nrfx HAL (nrf_saadc.h):
 *   0 = NC (Not Connected / Input Disabled)
 *   1 = AIN0 (P0.02 / Header Pin 18 / Silk 19 -> J2 Pin 1 JOY_X)
 *   2 = AIN1 (P0.03)
 *   3 = AIN2 (P0.04)
 *   4 = AIN3 (P0.05)
 *   5 = AIN4 (P0.28)
 *   6 = AIN5 (P0.29 / Header Pin 19 / Silk 20 -> J2 Pin 4 JOY_Y)
 *   7 = AIN6 (P0.30)
 *   8 = AIN7 (P0.31 / Header Pin 20 / Silk 21 -> J2 Pin 3 JOY_BTN)
 * Zephyr's adc_nrfx_saadc.c assigns positive_inputs directly to PSELP.
 */
#undef NRF_SAADC_AIN0
#define NRF_SAADC_AIN0 1
#undef NRF_SAADC_AIN5
#define NRF_SAADC_AIN5 6

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &nice_view;
    };

    /* -------------------------------------------------------------------------
     * 1. KEY MATRIX (5 Cols x 5 Rows for Keys S1..S22)
     * Hardware: Diodes point from Col/Switch (Anode) to Row (Cathode)
     * Driving Cols HIGH and reading Rows with internal Pull-Down (col2row)
     * ------------------------------------------------------------------------- */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&pro_micro 2 GPIO_ACTIVE_HIGH>  /* Col 0: P0.17 (Pin 5) */
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>  /* Col 1: P0.20 (Pin 6) */
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>  /* Col 2: P0.22 (Header Pin 7 / Silk 4 - native PCB routing) */
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>  /* Col 3: P0.24 (Pin 8) */
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>  /* Col 4: P1.00 (Pin 9) */
            ;

        row-gpios
            = <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 0: P0.11 (Pin 10) */
            , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 1: P1.04 (Pin 11) */
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 2: P1.06 (Pin 12) */
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 3: P0.10 (Pin 14) */
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 4: P0.09 (Pin 13) */
            ;
    };

    /* -------------------------------------------------------------------------
     * 2. DIRECT GPIO BUTTON (Joy-Con Stick Push / L3 Click on J2 Pin 3)
     * Active-Low with internal pull-up (Joy-Con push switch connects to GND on J2 Pin 2)
     * ------------------------------------------------------------------------- */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* P0.31 / Header Pin 20 / Silk 21 (J2 Pin 3) */
    };

    /* Composite kscan combining matrix keys and stick button */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        columns = <5>;
        rows = <6>;

        matrix {
            kscan = <&kscan0>;
        };

        direct {
            kscan = <&kscan_direct>;
            row-offset = <5>;
        };
    };

    /* -------------------------------------------------------------------------
     * 3. MATRIX TRANSFORM (27 Positions: S1..S22, L3 click, Stick Directions)
     * ------------------------------------------------------------------------- */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) /* S1 - S5   (Row 0) */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) /* S6 - S10  (Row 1) */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) /* S11 - S15 (Row 2) */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) /* S16 - S20 (Row 3) */
                    RC(4,2) RC(4,3)                 /* S21, S22   (Thumb) */
            RC(5,0)                                 /* Joy-Con Stick Click (L3) */
            RC(5,1) RC(5,2) RC(5,3) RC(5,4)         /* Virtual: Stick Up, Down, Left, Right */
        >;
    };

    /* -------------------------------------------------------------------------
     * 4. PHYSICAL LAYOUT FOR ZMK STUDIO (Live GUI key remapping)
     * ------------------------------------------------------------------------- */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Gremlin v3";
        kscan = <&kscan_composite>;
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100   0  55 0 0 0>  /* S1  */
            , <&key_physical_attrs 100 100 100  28 0 0 0>  /* S2  */
            , <&key_physical_attrs 100 100 200   0 0 0 0>  /* S3  */
            , <&key_physical_attrs 100 100 300  28 0 0 0>  /* S4  */
            , <&key_physical_attrs 100 100 400  55 0 0 0>  /* S5  */
            , <&key_physical_attrs 100 100   0 155 0 0 0>  /* S6  */
            , <&key_physical_attrs 100 100 100 128 0 0 0>  /* S7  */
            , <&key_physical_attrs 100 100 200 100 0 0 0>  /* S8  */
            , <&key_physical_attrs 100 100 300 128 0 0 0>  /* S9  */
            , <&key_physical_attrs 100 100 400 155 0 0 0>  /* S10 */
            , <&key_physical_attrs 100 100   0 255 0 0 0>  /* S11 */
            , <&key_physical_attrs 100 100 100 228 0 0 0>  /* S12 */
            , <&key_physical_attrs 100 100 200 200 0 0 0>  /* S13 */
            , <&key_physical_attrs 100 100 300 228 0 0 0>  /* S14 */
            , <&key_physical_attrs 100 100 400 255 0 0 0>  /* S15 */
            , <&key_physical_attrs 100 100   0 355 0 0 0>  /* S16 */
            , <&key_physical_attrs 100 100 100 328 0 0 0>  /* S17 */
            , <&key_physical_attrs 100 100 200 300 0 0 0>  /* S18 */
            , <&key_physical_attrs 100 100 300 328 0 0 0>  /* S19 */
            , <&key_physical_attrs 100 100 400 355 0 0 0>  /* S20 */
            , <&key_physical_attrs 100 100 265 424 0 0 0>  /* S21 (Thumb Left) */
            , <&key_physical_attrs 100 100 365 449 0 0 0>  /* S22 (Thumb Right) */
            , <&key_physical_attrs 100 100 650 350 0 0 0>  /* Stick Click (L3 Center) */
            , <&key_physical_attrs 100 100 650 240 0 0 0>  /* Stick Up */
            , <&key_physical_attrs 100 100 650 460 0 0 0>  /* Stick Down */
            , <&key_physical_attrs 100 100 540 350 0 0 0>  /* Stick Left */
            , <&key_physical_attrs 100 100 760 350 0 0 0>  /* Stick Right */
            ;
    };

    /* -------------------------------------------------------------------------
     * 5. ANALOG STICK DRIVER (wdtamagi/zmk-driver-analog-stick)
     * Calibrated to live 12-bit SAADC hardware readings in mounted keypad orientation:
     * - Driver X = &adc 1 (AIN5 / Header Pin 19): Left ~3217, Center ~1965, Right ~684 (invert-x)
     * - Driver Y = &adc 2 (AIN0 / Header Pin 18): Up ~301, Center ~1805, Down ~3246
     * ------------------------------------------------------------------------- */
    analog_stick0: analog_stick0 {
        compatible = "zmk,analog-stick";
        io-channels = <&adc 1>, <&adc 2>; /* X: Channel 1 (AIN5 / Pin 19), Y: Channel 2 (AIN0 / Pin 18); Ch 0 reserved for VDDH battery */
        invert-x;
        x-min = <760>;
        x-center = <1965>;
        x-max = <3140>;
        y-min = <390>;
        y-center = <1805>;
        y-max = <3160>;
        deadzone-percent = <20>;
        wait-period-idle = <100>;
        wait-period-active = <10>;
    };

    analog_stick_listener0: analog_stick_listener0 {
        compatible = "zmk,analog-stick-listener";
        device = <&analog_stick0>;

        /* Layer 0: Switch Mode (WASD / D-Pad emulation) */
        layer0 {
            layers = <0>;
            mode = <ANALOG_STICK_MODE_SWITCH>;
            switch-activation-point = <30>;
            switch-hysteresis = <6>;
            up-position = <23>;
            down-position = <24>;
            left-position = <25>;
            right-position = <26>;
        };

        /* Layer 1: Mouse Pointer Mode */
        layer1 {
            layers = <1>;
            mode = <ANALOG_STICK_MODE_MOUSE>;
            mouse-min-speed = <1>;
            mouse-max-speed = <20>;
        };

        /* Layer 2: Mouse Scroll Mode */
        layer2 {
            layers = <2>;
            mode = <ANALOG_STICK_MODE_SCROLL>;
        };
    };
};

/* -------------------------------------------------------------------------
 * 6. NRF52840 SAADC CONFIGURATION (Analog Inputs for Joy-Con Stick)
 * ------------------------------------------------------------------------- */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    /* Channel 2: AIN0 (U1 Pin 18 / P0.02 -> Keypad Up/Down axis).
     * SAADC Channel 0 is left free for zmk,battery-nrf-vddh (VDDHDIV5). */
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };

    /* Channel 1: AIN5 (U1 Pin 19 / P0.29 -> Keypad Left/Right axis) */
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;
        zephyr,resolution = <12>;
    };
};

/* -------------------------------------------------------------------------
 * 7. NICE!VIEW DISPLAY SOLDER PADS (Sharp Memory LCD via SPI3 diagnostic)
 *
 * Dedicated Solder Pads (J3):
 * - Pad 1: CS   -> U1 Pin 1  (P0.06)
 * - Pad 2: SCK  -> U1 Pin 16 (P1.13)
 * - Pad 3: MOSI -> U1 Pin 15 (P1.11)
 * - Pad 4: 3.3V -> U1 Pin 21 (3.3V)
 * - Pad 5: GND  -> GND plane
 * ------------------------------------------------------------------------- */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,   /* SCK:  P1.13 (Header Pin 16 / J3 Pad 2) */
                    <NRF_PSEL(SPIM_MOSI, 1, 11)>;  /* MOSI: P1.11 (Header Pin 15 / J3 Pad 3) */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 11)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; /* CS: P0.06 (Header Pin 1 / J3 Pad 1) */

    nice_view: ls0xx@0 {
        compatible = "sharp,ls0xx";
        reg = <0>;
        spi-max-frequency = <1000000>;
        width = <160>;
        height = <68>;
    };
};

/* Explicitly disable hardware UART0 to release P0.06 (Header Pin 1 / Silk 0) for DISP_CS */
&uart0 {
    status = "disabled";
};
