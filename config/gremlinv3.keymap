#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * ==============================================================================
 * Gremlin v3 Keymap Matrix Index Mapping:
 *
 * [ 0] S1    [ 1] S2    [ 2] S3    [ 3] S4    [ 4] S5
 * [ 5] S6    [ 6] S7    [ 7] S8    [ 8] S9    [ 9] S10
 * [10] S11   [11] S12   [12] S13   [13] S14   [14] S15
 * [15] S16   [16] S17   [17] S18   [18] S19   [19] S20
 *                       [20] S21   [21] S22
 * [22] Joy-Con Stick Click (L3)
 * [23] Stick UP   [24] Stick DOWN   [25] Stick LEFT   [26] Stick RIGHT
 * ==============================================================================
 */

/ {
    combos {
        compatible = "zmk,combos";

        /* Press both thumb keys (G + V / S21 + S22) to momentarily activate Settings layer */
        combo_settings {
            timeout-ms = <60>;
            key-positions = <20 21>;
            bindings = <&mo 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ----------------------------------------------------------------------
         * Layer 0: Game / Default
         * Top 2 rows: Ctrl + Numbers (Ctrl+1..5, Ctrl+6..0)
         * Bottom 2 rows: Numbers (1..5, 6..9), Space
         * Thumbs: G (S21), V (S22)
         * Analog Stick Mode: SWITCH (Emulates WASD) + Click (0)
         * ----------------------------------------------------------------------
         */
        default_layer {
            display-name = "Game";
            bindings = <
                /* Row 0: S1 - S5 (Ctrl + 1..5) */
                &kp LC(N1)    &kp LC(N2)    &kp LC(N3)    &kp LC(N4)    &kp LC(N5)
                /* Row 1: S6 - S10 (Ctrl + 6..0) */
                &kp LC(N6)    &kp LC(N7)    &kp LC(N8)    &kp LC(N9)    &kp LC(N0)
                /* Row 2: S11 - S15 (Numbers 1..5) */
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5
                /* Row 3: S16 - S20 (Numbers 6..9, Space) */
                &kp N6        &kp N7        &kp N8        &kp N9        &kp SPACE
                /* Thumb Keys: S21, S22 */
                &kp G         &kp V
                /* Joy-Con Stick Click (L3) */
                &kp N0
                /* Joy-Con Analog Stick Directions (Switch Mode: WASD) */
                &kp W         &kp S         &kp A         &kp D
            >;
        };

        /*
         * ----------------------------------------------------------------------
         * Layer 1: Mouse & Navigation
         * Analog Stick Mode: MOUSE
         * ----------------------------------------------------------------------
         */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                /* Row 0: Function Keys */
                &kp F1        &kp F2        &kp F3        &kp F4        &kp F5
                /* Row 1: Navigation & Volume */
                &kp HOME      &kp UP        &kp END       &kp PG_UP     &kp C_VOL_UP
                /* Row 2: Navigation & Volume */
                &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN     &kp C_VOL_DN
                /* Row 3: Mouse Clicks & Media */
                &mkp LCLK     &mkp MCLK     &mkp RCLK     &kp C_PP      &kp SPACE
                /* Thumb Keys */
                &kp G         &kp V
                /* Joy-Con Stick Click (L3) -> Right Click */
                &mkp RCLK
                /* Joy-Con Analog Stick Directions (Inactive in Mouse Mode) */
                &none         &none         &none         &none
            >;
        };

        /*
         * ----------------------------------------------------------------------
         * Layer 2: Media & System
         * Analog Stick Mode: SCROLL
         * ----------------------------------------------------------------------
         */
        media_layer {
            display-name = "Media";
            bindings = <
                /* Row 0: F6 - F10 */
                &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
                /* Row 1: Media Control */
                &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP
                /* Row 2: Arrow Keys & Enter */
                &kp LEFT      &kp UP        &kp DOWN      &kp RIGHT     &kp ENTER
                /* Row 3: Navigation */
                &kp ESC       &kp TAB       &kp BSPC      &kp DEL       &kp SPACE
                /* Thumb Keys */
                &kp G         &kp V
                /* Joy-Con Stick Click (L3) -> Mute */
                &kp C_MUTE
                /* Joy-Con Analog Stick Directions (Inactive in Scroll Mode) */
                &none         &none         &none         &none
            >;
        };

        /*
         * ----------------------------------------------------------------------
         * Layer 3: Settings (4th Layer)
         * - Bluetooth profile selection and clear controls
         * - Layer navigation controls
         * ----------------------------------------------------------------------
         */
        settings_layer {
            display-name = "Settings";
            bindings = <
                /* Row 0: S1 - S5 (BT Profiles 1..5) */
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                /* Row 1: S6 = Clear Current BT, S7 = Clear ALL BT, Extras */
                &bt BT_CLR    &bt BT_CLR_ALL &out OUT_TOG &studio_unlock &bootloader
                /* Row 2: Unused */
                &none         &none         &none         &none         &none
                /* Row 3: S16 (Row 4 Key 6) = Down; S17 (Row 4 Key 7) = Up */
                &to 2         &to 1         &none         &none         &none
                /* Thumb Keys */
                &trans        &trans
                /* Stick Click & Directions */
                &studio_unlock
                &none         &none         &none         &none
            >;
        };
    };
};
