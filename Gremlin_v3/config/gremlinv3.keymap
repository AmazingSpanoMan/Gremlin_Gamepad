#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * ==============================================================================
 * Gremlin v3 Keymap Matrix Index Mapping:
 *
 * [ 0] S1    [ 1] S2    [ 2] S3    [ 3] S4    [ 4] S5
 * [ 5] S6    [ 6] S7    [ 7] S8    [ 8] S9    [ 9] S10
 * [10] S11   [11] S12   [12] S13   [13] S14   [14] S15
 * [15] S16   [16] S17   [17] S18   [18] S19   [19] S20
 *                       [20] S21   [21] S22
 * [22] Joy-Con Stick Click (L3)
 * [23] Stick UP   [24] Stick DOWN   [25] Stick LEFT   [26] Stick RIGHT
 * ==============================================================================
 */

/ {
    combos {
        compatible = "zmk,combos";

        /* Press both thumb keys (S21 + S22) to toggle Layer 2 (System/Bluetooth) */
        combo_system_layer {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&tog 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ----------------------------------------------------------------------
         * Layer 0: Gaming / Default
         * Analog Stick Mode: SWITCH (Emulates WASD movement)
         * ----------------------------------------------------------------------
         */
        default_layer {
            display-name = "Game";
            bindings = <
                /* Row 0: S1 - S5 */
                &kp ESC       &kp N1        &kp N2        &kp N3        &kp N4
                /* Row 1: S6 - S10 */
                &kp TAB       &kp Q         &kp W         &kp E         &kp R
                /* Row 2: S11 - S15 */
                &kp LSHIFT    &kp A         &kp S         &kp D         &kp F
                /* Row 3: S16 - S20 */
                &kp LCTRL     &kp Z         &kp X         &kp C         &kp V
                /* Thumb Keys: S21, S22 */
                &kp SPACE     &mo 1
                /* Joy-Con Stick Click (L3) */
                &kp LALT
                /* Joy-Con Analog Stick Directions (Switch Mode: WASD) */
                &kp W         &kp S         &kp A         &kp D
            >;
        };

        /*
         * ----------------------------------------------------------------------
         * Layer 1: Mouse & Navigation
         * Analog Stick Mode: MOUSE (Distance from center controls cursor speed)
         * ----------------------------------------------------------------------
         */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                /* Row 0: Function Keys */
                &kp F1        &kp F2        &kp F3        &kp F4        &kp F5
                /* Row 1: Navigation & Volume */
                &kp HOME      &kp UP        &kp END       &kp PG_UP     &kp C_VOL_UP
                /* Row 2: Navigation & Volume */
                &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_DN     &kp C_VOL_DN
                /* Row 3: Mouse Clicks & Media */
                &mkp LCLK     &mkp MCLK     &mkp RCLK     &kp C_PP      &mo 2
                /* Thumb Keys */
                &mkp LCLK     &trans
                /* Joy-Con Stick Click (L3) -> Right Click in Mouse Mode */
                &mkp RCLK
                /* Joy-Con Analog Stick Directions (Inactive in Mouse Mode: stick sends mouse events) */
                &none         &none         &none         &none
            >;
        };

        /*
         * ----------------------------------------------------------------------
         * Layer 2: System / Bluetooth / Scroll
         * Analog Stick Mode: SCROLL (Distance from center controls scroll wheel)
         * ----------------------------------------------------------------------
         */
        system_layer {
            display-name = "System";
            bindings = <
                /* Row 0: Bluetooth Profiles 0-3 & Clear */
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
                /* Row 1: BLE/USB Output Switch, Studio Unlock, Bootloader */
                &out OUT_BLE  &out OUT_USB  &none         &studio_unlock &bootloader
                /* Row 2: System Reset */
                &sys_reset    &none         &none         &none         &none
                /* Row 3: Utility */
                &none         &none         &none         &none         &trans
                /* Thumb Keys: Return to Game Layer */
                &to 0         &trans
                /* Joy-Con Stick Click (L3) -> Studio Unlock */
                &studio_unlock
                /* Joy-Con Analog Stick Directions (Inactive in Scroll Mode: stick sends wheel events) */
                &none         &none         &none         &none
            >;
        };
    };
};
